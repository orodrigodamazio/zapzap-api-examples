# Credentials from your ZapZap dashboard (API / Integration)
ZAPZAP_API_KEY=YOUR_API_KEY
ZAPZAP_API_SECRET=YOUR_API_SECRET

# The instance (WhatsApp number) you send through — a UUID from GET /instances
ZAPZAP_INSTANCE_ID=YOUR_INSTANCE_ID

# Base URL (leave as-is unless self-hosting)
ZAPZAP_BASE_URL=https://api.zapzapapi.com/api/v1

# Port the webhook/ai-bot Flask server listens on
PORT=3000

# Shared secret appended to the webhook URL to verify the sender
WEBHOOK_SECRET=change_me_to_a_long_random_string

# Only for ai_bot.py
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
